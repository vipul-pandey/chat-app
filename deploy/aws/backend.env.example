NODE_ENV=production
HOST=127.0.0.1
PORT=5100
SERVE_FRONTEND=false
FRONTEND_ORIGINS=https://chat-app-psi-orcin.vercel.app
# Set actual values only in /etc/chat-app/backend.env on the server.
# Preserve the existing production JWT secret and database during migration.
MONGO_URI=replace-with-existing-production-mongodb-uri
JWT_SECRET=replace-with-existing-production-jwt-secret
GEMINI_API_KEY=replace-with-existing-production-gemini-key
